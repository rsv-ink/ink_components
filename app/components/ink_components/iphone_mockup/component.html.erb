<%= content_tag :div, attributes do %>
  <div class="<%= style(:device) %>">
    <div class="absolute inset-0 pointer-events-none">
      <% side_buttons.each do |name, button| %>
        <span data-iphone-mockup="side-button"
              data-side-button="<%= name.to_s.dasherize %>"
              class="<%= side_button_class(button) %>"></span>
      <% end %>

      <div data-iphone-mockup="body" class="<%= style(:body, color:) %>"></div>
    </div>

    <div data-iphone-mockup="screen" data-screen-state="<%= screen_state %>" class="<%= screen_class %>">
      <div class="absolute inset-0 flex flex-col">
        <%= content %>
      </div>

      <div data-iphone-mockup="dynamic-island" class="<%= style(:dynamic_island) %>"></div>

      <% if home_indicator %>
        <div data-iphone-mockup="home-indicator" class="<%= style(:home_indicator) %>">
          <span class="<%= style(:home_indicator_bar) %>"></span>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
