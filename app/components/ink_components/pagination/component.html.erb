<%= content_tag :nav, attributes do %>
  <% if numbered? %>
    <ul class="<%= list_classes %>">
      <li><%= edge_cell(:previous) %></li>
      <% page_items.each do |page| %>
        <li><%= page_cell(page) %></li>
      <% end %>
      <li><%= edge_cell(:next) %></li>
    </ul>
  <% end %>

  <% if type == :dropdown %>
    <%= content_tag :form, method: :get, action: form_action, class: "flex shrink-0 items-center gap-2" do %>
      <%= hidden_query_params %>
      <label for="<%= per_page_select_id %>" class="sr-only"><%= translation(:select_option) %></label>
      <%= select_tag per_page_param, options_for_select(per_page_choices, per_page), id: per_page_select_id, class: field_classes, **auto_submit_attributes %>
      <% if submit_button? %>
        <button type="submit" class="<%= submit_classes %>"><%= translation(:go) %></button>
      <% end %>
    <% end %>
  <% end %>

  <% if type == :input %>
    <%= content_tag :form, method: :get, action: form_action, class: "flex items-center gap-2" do %>
      <%= hidden_query_params %>
      <label for="<%= page_field_id %>" class="<%= style(:label) %>"><%= translation(:go_to) %></label>
      <%= number_field_tag param_name, current_page, id: page_field_id, min: 1, max: total_pages, class: "#{field_classes} w-16" %>
      <span class="<%= style(:label) %>"><%= translation(:page) %></span>
    <% end %>
  <% end %>

  <% if type == :input_button %>
    <%= content_tag :form, method: :get, action: form_action, class: "flex items-center gap-3" do %>
      <%= hidden_query_params %>
      <div class="flex items-center gap-2">
        <label for="<%= page_field_id %>" class="<%= style(:label) %>"><%= translation(:go_to) %></label>
        <%= number_field_tag param_name, current_page, id: page_field_id, min: 1, max: total_pages, class: "#{field_classes} w-16" %>
        <span class="<%= style(:label) %>"><%= translation(:page) %></span>
      </div>
      <button type="submit" class="<%= submit_classes %>"><%= translation(:go) %></button>
    <% end %>
  <% end %>

  <% if type == :select_buttons %>
    <%= content_tag :form, method: :get, action: form_action, class: "flex items-center gap-3" do %>
      <%= hidden_query_params %>
      <label for="<%= page_field_id %>" class="sr-only"><%= translation(:select_option) %></label>
      <%= select_tag param_name, options_for_select(page_choices, current_page), id: page_field_id, class: "#{field_classes} w-20", **auto_submit_attributes %>
      <%= text_field_tag :total_pages, of_pages_text, id: total_pages_field_id, name: nil, disabled: true, class: "#{disabled_field_classes} w-32" %>
      <% if submit_button? %>
        <button type="submit" class="<%= submit_classes %>"><%= translation(:go) %></button>
      <% end %>
    <% end %>
    <div class="<%= style(:group, shadowed: true) %>" role="group">
      <%= edge_cell(:previous, position: :leading) %>
      <%= edge_cell(:next, position: :trailing) %>
    </div>
  <% end %>

  <% if type == :single %>
    <div class="<%= style(:group, shadowed: true) %>" role="group">
      <%= edge_cell(:previous, position: :leading) %>
      <span class="<%= single_label_classes %>"><%= page_of_text %></span>
      <%= edge_cell(:next, position: :trailing) %>
    </div>
  <% end %>

  <% if simple? %>
    <div class="<%= style(:simple_group) %>">
      <%= standalone_edge(:previous) %>
      <%= standalone_edge(:next) %>
    </div>
  <% end %>

  <% if table? %>
    <% if total_entries.present? %>
      <span class="<%= style(:help_text) %>"><%= entries_text %></span>
    <% end %>
    <div class="<%= style(:group, spaced: total_entries.present?) %>">
      <%= standalone_edge(:previous, position: :leading) %>
      <%= standalone_edge(:next, position: :trailing) %>
    </div>
  <% end %>
<% end %>
