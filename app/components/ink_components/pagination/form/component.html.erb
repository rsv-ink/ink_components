<%= content_tag :form, form_attributes do %>
  <%= hidden_fields %>

  <% if per_page_select? %>
    <label for="<%= per_page_select_id %>" class="sr-only"><%= select_option_label %></label>
    <%= select_tag per_page_param, options_for_select(per_page_choices, per_page), id: per_page_select_id, class: field_classes, **handler_attributes %>
  <% end %>

  <% if page_select? %>
    <label for="<%= page_field_id %>" class="sr-only"><%= select_option_label %></label>
    <% if select_control? %>
      <%= select_tag param_name, options_for_select(page_choices, current_page), id: page_field_id, class: field_classes("w-20"), **handler_attributes %>
    <% else %>
      <%= number_field_tag param_name, current_page, id: page_field_id, min: 1, max: total_pages, class: field_classes("w-20") %>
    <% end %>
    <%= text_field_tag :total_pages, of_pages_text, id: total_pages_field_id, name: nil, disabled: true, class: disabled_field_classes("w-32") %>
  <% end %>

  <% if page_field? %>
    <label for="<%= page_field_id %>" class="<%= label_classes %>"><%= go_to_label %></label>
    <%= number_field_tag param_name, current_page, id: page_field_id, min: 1, max: total_pages, class: field_classes("w-16") %>
    <span class="<%= label_classes %>"><%= page_label %></span>
  <% end %>

  <% if submit_button? %>
    <button type="submit" class="<%= submit_classes %>"><%= go_label %></button>
  <% end %>
<% end %>
